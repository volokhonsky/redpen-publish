      500,
      455
    ]
  },
  {
    "id": "page_232_line023",
    "text": "МинистерстваМинистерстваНародные ",
    "bbox": [
      0,
      460,
      500,
      475
    ]
  },
  {
    "id": "page_232_line024",
    "text": "комиссариаты ",
    "bbox": [
