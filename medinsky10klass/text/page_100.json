[
  {
    "id": "page_100_line000",
    "text": "99 § 9. На фронтах Гражданской войны",
    "bbox": [
      0,
      0,
      500,
      15
    ]
  },
  {
    "id": "page_100_line001",
    "text": "входили бывшие военнопленные, согласившиеся воевать против гер­",
    "bbox": [
      0,
      20,
      500,
      35
    ]
  },
  {
    "id": "page_100_line002",
    "text": "мано­австрийского блока. Силами корпуса были взяты Челябинск, ",
    "bbox": [
      0,
      40,
      500,
      55
    ]
  },
  {
    "id": "page_100_line003",
    "text": "Омск, Томск, Екатеринбург. В Самаре эсерами образован Комуч, ",
    "bbox": [
      0,
      60,
      500,
      75
    ]
  },
  {
    "id": "page_100_line004",
    "text": "провозгласивший себя верховной властью (правительством России), действующей от имени распущенного Учредительного собрания. ",
    "bbox": [
      0,
      80,
      500,
      95
    ]
  },
  {
    "id": "page_100_line005",
    "text": "В сентябре 1918 г. в Уфе сформировалось ещё одно Временное ",
    "bbox": [
      0,
      100,
      500,
      115
    ]
  },
  {
    "id": "page_100_line006",
    "text": "всероссийское правительство  — Уфимская директория. В её состав вошли правые эсеры, кадеты, ряд генералов.",
    "bbox": [
      0,
      120,
      500,
      135
    ]
  },
  {
    "id": "page_100_line007",
    "text": "18  ноября 1918  г. офицеры свергли эсеро­меньшевистское  ",
    "bbox": [
      0,
      140,
      500,
      155
    ]
  },
  {
    "id": "page_100_line008",
    "text": "правительство в Омске и установили диктатуру во главе с адмира­",
    "bbox": [
      0,
      160,
      500,
      175
    ]
  },
  {
    "id": "page_100_line009",
    "text": "лом А.  Колчаком. Он был провозглашён Верховным правителем ",
    "bbox": [
      0,
      180,
      500,
      195
    ]
  },
  {
    "id": "page_100_line010",
    "text": "России. ",
    "bbox": [
      0,
      200,
      500,
      215
    ]
  },
  {
    "id": "page_100_line011",
    "text": "На территории, находившейся под контролем большевиков, ",
    "bbox": [
      0,
      220,
      500,
      235
    ]
  },
  {
    "id": "page_100_line012",
    "text": "действовали подпольные группы, состоявшие в основном из эсе­",
    "bbox": [
      0,
      240,
      500,
      255
    ]
  },
  {
    "id": "page_100_line013",
    "text": "ров. Для борьбы с большевиками они использовали привычные им ещё с царских времён методы — забастовки и террор. 6 июля 1918 г. Союз защиты Родины и свободы (лидер — Б. Савинков) в резуль­",
    "bbox": [
      0,
      260,
      500,
      275
    ]
  },
  {
    "id": "page_100_line014",
    "text": "тате вооружённого мятежа захватил Ярославль. Однако восстание ",
    "bbox": [
      0,
      280,
      500,
      295
    ]
  },
  {
    "id": "page_100_line015",
    "text": "было быстро подавлено.",
    "bbox": [
      0,
      300,
      500,
      315
    ]
  },
  {
    "id": "page_100_line016",
    "text": "Колчак  ",
    "bbox": [
      0,
      320,
      500,
      335
    ]
  },
  {
    "id": "page_100_line017",
    "text": "Александр  ",
    "bbox": [
      0,
      340,
      500,
      355
    ]
  },
  {
    "id": "page_100_line018",
    "text": "Васильевич",
    "bbox": [
      0,
      360,
      500,
      375
    ]
  },
  {
    "id": "page_100_line019",
    "text": "(1871—1920)",
    "bbox": [
      0,
      380,
      500,
      395
    ]
  },
  {
    "id": "page_100_line020",
    "text": "Один из руководителей Белого движе-",
    "bbox": [
      0,
      400,
      500,
      415
    ]
  },
  {
    "id": "page_100_line021",
    "text": "ния. Происходил из служилого дворян-",
    "bbox": [
      0,
      420,
      500,
      435
    ]
  },
  {
    "id": "page_100_line022",
    "text": "ства. Учился в Морском кадетском корпу-",
    "bbox": [
      0,
      440,
      500,
      455
    ]
  },
  {
    "id": "page_100_line023",
    "text": "се, участвовал в нескольких полярных ",
    "bbox": [
      0,
      460,
      500,
      475
    ]
  },
  {
    "id": "page_100_line024",
    "text": "экспедициях. Во время Русско-японской ",
    "bbox": [
      0,
      480,
      500,
      495
    ]
  },
  {
    "id": "page_100_line025",
    "text": "войны командовал эсминцем и батареей ",
    "bbox": [
      0,
      500,
      500,
      515
    ]
  },
  {
    "id": "page_100_line026",
    "text": "в Порт-Артуре. В Первой мировой войне ",
    "bbox": [
      0,
      520,
      500,
      535
    ]
  },
  {
    "id": "page_100_line027",
    "text": "воевал вначале на Балтике, затем был  ",
    "bbox": [
      0,
      540,
      500,
      555
    ]
  },
  {
    "id": "page_100_line028",
    "text": "назначен командующим Черноморским флотом. В мае 1917  г. самовольно оста-",
    "bbox": [
      0,
      560,
      500,
      575
    ]
  },
  {
    "id": "page_100_line029",
    "text": "вил командование. Но Временное прави-тельство не решилось предать его суду,  ",
    "bbox": [
      0,
      580,
      500,
      595
    ]
  },
  {
    "id": "page_100_line030",
    "text": "а направило в  командировку в США. Впоследствии поступил на английскую ",
    "bbox": [
      0,
      600,
      500,
      615
    ]
  },
  {
    "id": "page_100_line031",
    "text": "военную службу и был послан на сухопут-",
    "bbox": [
      0,
      620,
      500,
      635
    ]
  },
  {
    "id": "page_100_line032",
    "text": "ный Месопотамский фронт, но по дороге ",
    "bbox": [
      0,
      640,
      500,
      655
    ]
  },
  {
    "id": "page_100_line033",
    "text": "туда был возвращен. Через Японию и Ки-",
    "bbox": [
      0,
      660,
      500,
      675
    ]
  },
  {
    "id": "page_100_line034",
    "text": "тай в ноябре 1918 г. вместе с британским ",
    "bbox": [
      0,
      680,
      500,
      695
    ]
  },
  {
    "id": "page_100_line035",
    "text": "генералом Ноксом прибыл в Омск, где ",
    "bbox": [
      0,
      700,
      500,
      715
    ]
  },
  {
    "id": "page_100_line036",
    "text": "был назначен военным и морским мини-",
    "bbox": [
      0,
      720,
      500,
      735
    ]
  },
  {
    "id": "page_100_line037",
    "text": "стром правительства Директории. Совер-",
    "bbox": [
      0,
      740,
      500,
      755
    ]
  },
  {
    "id": "page_100_line038",
    "text": "шив переворот, установил в Сибири воен-",
    "bbox": [
      0,
      760,
      500,
      775
    ]
  },
  {
    "id": "page_100_line039",
    "text": "ную диктатуру и принял титул Верховного ",
    "bbox": [
      0,
      780,
      500,
      795
    ]
  },
  {
    "id": "page_100_line040",
    "text": "правителя Всероссийского правитель-",
    "bbox": [
      0,
      800,
      500,
      815
    ]
  },
  {
    "id": "page_100_line041",
    "text": "ства. После поражений белых на Восточ-",
    "bbox": [
      0,
      820,
      500,
      835
    ]
  },
  {
    "id": "page_100_line042",
    "text": "ном фронте и отступления в Сибирь был ",
    "bbox": [
      0,
      840,
      500,
      855
    ]
  },
  {
    "id": "page_100_line043",
    "text": "взят под охрану Чехословацким корпу-",
    "bbox": [
      0,
      860,
      500,
      875
    ]
  },
  {
    "id": "page_100_line044",
    "text": "сом, но затем выдан советским властям. ",
    "bbox": [
      0,
      880,
      500,
      895
    ]
  },
  {
    "id": "page_100_line045",
    "text": "Расстрелян по решению Иркутского рев-",
    "bbox": [
      0,
      900,
      500,
      915
    ]
  },
  {
    "id": "page_100_line046",
    "text": "кома 7 февраля 1920 г.ПОРтРЕт НА  ФОНЕ  эПОХИ",
    "bbox": [
      0,
      920,
      500,
      935
    ]
  }
]