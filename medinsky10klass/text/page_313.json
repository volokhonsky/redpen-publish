[
  {
    "id": "page_313_line000",
    "text": "312 ГЛАВА III",
    "bbox": [
      0,
      0,
      500,
      15
    ]
  },
  {
    "id": "page_313_line001",
    "text": "Причинами поражений были: незавершённость программы ",
    "bbox": [
      0,
      20,
      500,
      35
    ]
  },
  {
    "id": "page_313_line002",
    "text": "реорганизации и перевооружения Красной Армии, отсутствие ",
    "bbox": [
      0,
      40,
      500,
      55
    ]
  },
  {
    "id": "page_313_line003",
    "text": "опыта у командного состава и, главное, — запоздалое решение о развёртывании и сосредоточении войск для отражения нападения. Это привело к крайне тяжёлому для Красной Армии развитию событий в самом начале войны. А затем долгое время сказывалось в ходе последующих сражений, поскольку немецкой армии удалось захватить стратегическую инициативу. ",
    "bbox": [
      0,
      60,
      500,
      75
    ]
  },
  {
    "id": "page_313_line004",
    "text": "Защитники Брестской крепости",
    "bbox": [
      0,
      80,
      500,
      95
    ]
  },
  {
    "id": "page_313_line005",
    "text": "Ярчайшим примером стойкости и муже-",
    "bbox": [
      0,
      100,
      500,
      115
    ]
  },
  {
    "id": "page_313_line006",
    "text": "ства стал подвиг гарнизона Брестской ",
    "bbox": [
      0,
      120,
      500,
      135
    ]
  },
  {
    "id": "page_313_line007",
    "text": "крепости, попавшей под удар в самые пер-",
    "bbox": [
      0,
      140,
      500,
      155
    ]
  },
  {
    "id": "page_313_line008",
    "text": "вые часы вторжения. Построенная в пер-",
    "bbox": [
      0,
      160,
      500,
      175
    ]
  },
  {
    "id": "page_313_line009",
    "text": "вой половине XIX в. крепость использова-",
    "bbox": [
      0,
      180,
      500,
      195
    ]
  },
  {
    "id": "page_313_line010",
    "text": "лась в качестве казарм для размещения ",
    "bbox": [
      0,
      200,
      500,
      215
    ]
  },
  {
    "id": "page_313_line011",
    "text": "войск. В случае тревоги они должны были ",
    "bbox": [
      0,
      220,
      500,
      235
    ]
  },
  {
    "id": "page_313_line012",
    "text": "выйти из крепости и занять оборону в ",
    "bbox": [
      0,
      240,
      500,
      255
    ]
  },
  {
    "id": "page_313_line013",
    "text": "окрестностях Бреста. Немецкое командо -",
    "bbox": [
      0,
      260,
      500,
      275
    ]
  },
  {
    "id": "page_313_line014",
    "text": "вание рассчитывало, что мощный артил-лерийский удар из сверхтяжёлых орудий ",
    "bbox": [
      0,
      280,
      500,
      295
    ]
  },
  {
    "id": "page_313_line015",
    "text": "настолько ошеломит застигнутых врас-",
    "bbox": [
      0,
      300,
      500,
      315
    ]
  },
  {
    "id": "page_313_line016",
    "text": "плох защитников, что на «зачистку» по -",
    "bbox": [
      0,
      320,
      500,
      335
    ]
  },
  {
    "id": "page_313_line017",
    "text": "требуется от силы несколько часов. Одна-ко, быстро преодолев первоначальную ",
    "bbox": [
      0,
      340,
      500,
      355
    ]
  },
  {
    "id": "page_313_line018",
    "text": "растерянность, советские бойцы укрыли ",
    "bbox": [
      0,
      360,
      500,
      375
    ]
  },
  {
    "id": "page_313_line019",
    "text": "в  подвалах раненых, женщин и детей ",
    "bbox": [
      0,
      380,
      500,
      395
    ]
  },
  {
    "id": "page_313_line020",
    "text": "(в  крепости жили семьи многих команди-",
    "bbox": [
      0,
      400,
      500,
      415
    ]
  },
  {
    "id": "page_313_line021",
    "text": "ров) и стали налаживать оборону, перехо -",
    "bbox": [
      0,
      420,
      500,
      435
    ]
  },
  {
    "id": "page_313_line022",
    "text": "дя в контр атаки и уничтожая прорвавших-",
    "bbox": [
      0,
      440,
      500,
      455
    ]
  },
  {
    "id": "page_313_line023",
    "text": "ся в крепость гитлеровцев. Первый утренний штурм провалился. Это застави-",
    "bbox": [
      0,
      460,
      500,
      475
    ]
  },
  {
    "id": "page_313_line024",
    "text": "ло немецкое командование отвести сол-",
    "bbox": [
      0,
      480,
      500,
      495
    ]
  },
  {
    "id": "page_313_line025",
    "text": "дат на внешние валы крепости и начать ",
    "bbox": [
      0,
      500,
      500,
      515
    ]
  },
  {
    "id": "page_313_line026",
    "text": "непрерывные артиллерийские обстрелы и ",
    "bbox": [
      0,
      520,
      500,
      535
    ]
  },
  {
    "id": "page_313_line027",
    "text": "налёты бомбардировочной авиации. Бло -",
    "bbox": [
      0,
      540,
      500,
      555
    ]
  },
  {
    "id": "page_313_line028",
    "text": "кированные в подвальных казематах люди страдали от жары, дыма и полного отсут-",
    "bbox": [
      0,
      560,
      500,
      575
    ]
  },
  {
    "id": "page_313_line029",
    "text": "ствия воды: все подходы к реке простре-",
    "bbox": [
      0,
      580,
      500,
      595
    ]
  },
  {
    "id": "page_313_line030",
    "text": "ливались врагом. Разрозненные группы ",
    "bbox": [
      0,
      600,
      500,
      615
    ]
  },
  {
    "id": "page_313_line031",
    "text": "защитников объединились и создали штаб ",
    "bbox": [
      0,
      620,
      500,
      635
    ]
  },
  {
    "id": "page_313_line032",
    "text": "обороны, который возглавили капитан ",
    "bbox": [
      0,
      640,
      500,
      655
    ]
  },
  {
    "id": "page_313_line033",
    "text": "И. Зубачёв и его заместитель полковой ко -",
    "bbox": [
      0,
      660,
      500,
      675
    ]
  },
  {
    "id": "page_313_line034",
    "text": "миссар Е. Фомин. 26 июня под командова-нием лейтенанта А. Виноградова была ",
    "bbox": [
      0,
      680,
      500,
      695
    ]
  },
  {
    "id": "page_313_line035",
    "text": "предпринята попытка прорыва из окруже-",
    "bbox": [
      0,
      700,
      500,
      715
    ]
  },
  {
    "id": "page_313_line036",
    "text": "ния, но почти все её участники погибли ",
    "bbox": [
      0,
      720,
      500,
      735
    ]
  },
  {
    "id": "page_313_line037",
    "text": "или были захвачены в плен. В крепости ",
    "bbox": [
      0,
      740,
      500,
      755
    ]
  },
  {
    "id": "page_313_line038",
    "text": "остались лишь отдельные группы бойцов, ",
    "bbox": [
      0,
      760,
      500,
      775
    ]
  },
  {
    "id": "page_313_line039",
    "text": "но сопротивление продолжалось. 15 июля ",
    "bbox": [
      0,
      780,
      500,
      795
    ]
  },
  {
    "id": "page_313_line040",
    "text": "1941 г. защитник крепости связкой гранат, ",
    "bbox": [
      0,
      800,
      500,
      815
    ]
  },
  {
    "id": "page_313_line041",
    "text": "сброшенной с башни Тереспольских во -",
    "bbox": [
      0,
      820,
      500,
      835
    ]
  },
  {
    "id": "page_313_line042",
    "text": "рот, уничтожил группу фашистов. В 1952 г. на стене каземата в северо-западной ча-",
    "bbox": [
      0,
      840,
      500,
      855
    ]
  },
  {
    "id": "page_313_line043",
    "text": "сти оборонительной казармы была найде-на надпись: «Я умираю, но не сдаюсь! ",
    "bbox": [
      0,
      860,
      500,
      875
    ]
  },
  {
    "id": "page_313_line044",
    "text": "Прощай, Родина. 20.VII.41». Одним из по -",
    "bbox": [
      0,
      880,
      500,
      895
    ]
  },
  {
    "id": "page_313_line045",
    "text": "следних защитников крепости был захва-чен в плен майор П. Гаврилов. Это случи-",
    "bbox": [
      0,
      900,
      500,
      915
    ]
  },
  {
    "id": "page_313_line046",
    "text": "лось лишь 23 июля, на 32-й день войны. ",
    "bbox": [
      0,
      920,
      500,
      935
    ]
  },
  {
    "id": "page_313_line047",
    "text": "В 1965 г. Брестской крепости, защитники ",
    "bbox": [
      0,
      940,
      500,
      955
    ]
  },
  {
    "id": "page_313_line048",
    "text": "которой летом 1941 г. проявили беспри-",
    "bbox": [
      0,
      960,
      500,
      975
    ]
  },
  {
    "id": "page_313_line049",
    "text": "мерный героизм, было присвоено почёт-",
    "bbox": [
      0,
      980,
      500,
      995
    ]
  },
  {
    "id": "page_313_line050",
    "text": "ное звание «Крепость-герой».ЧЕСтЬ  И СЛАВА  ОтЕЧЕСтВА",
    "bbox": [
      0,
      1000,
      500,
      1015
    ]
  }
]